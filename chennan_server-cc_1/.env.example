# 初始超管：仅当库里还没有任何「活跃超管」时才会创建。
# 不要填 admin / 888（启动时会自动禁用这两个历史账号）。
#ADMIN_USERNAME=your_super_admin
#ADMIN_PASSWORD=your_strong_password

# 启动时禁用的历史超管用户名（逗号分隔）。默认 admin,888；设为 - 可关闭清理。
#ADMIN_PURGE_USERNAMES=admin,888

APP_ADDR=127.0.0.1
APP_PORT=8080
APP_CORS_ALLOWED_ORIGINS=https://api.ruizhihe.com,https://api.prfgsu.com,https://api.uktjwg.cn,https://rzh35ht.ruizhihe.com,https://*.ruizhihe.com,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175
APP_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
APP_REAL_IP_HEADER_ORDER=X-Real-IP
LOG_DIR=./logs
DATA_DIR=./data
LOG_LEVEL=info
TIMEZONE=Asia/Shanghai

JWT_SECRET=
JWT_EXPIRY=24h
JWT_SUPER_ADMIN_EXPIRY=4320h

TOTP_ENCRYPTION_KEY=

MYSQL_ADDR=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWD=
MYSQL_DATABASE=
MYSQL_OPTIONS=charset=utf8mb4&parseTime=true&loc=Local&timeout=2s&readTimeout=15s&writeTimeout=15s
MYSQL_MAX_OPEN_CONNS=50
MYSQL_MAX_IDLE_CONNS=20
MYSQL_CONN_MAX_IDLE_TIME=3m
MYSQL_CONN_MAX_LIFETIME=6m

TENCENT_IM_SDK_APP_ID=1600163137
TENCENT_IM_APP_KEY=
TENCENT_IM_ADMIN_USER=administrator
# 必填，至少32个随机字符；未配置时腾讯回调接口会拒绝所有请求。
# 腾讯云 IM 控制台「回调配置」URL 填：https://<API域名>/api/v1/webhook/tencent
# 必须打开：Sns.CallbackPrevFriendAdd、Sns.CallbackFriendAdd、Sns.CallbackPrevFriendResponse
# Token 必须和下面这个值一致。
TENCENT_IM_CALLBACK_TOKEN=

COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou
# 聊天大文件必须使用独立私有桶和专用 CAM Secret，不回退复用头像/媒体 COS。
COS_CHAT_SECRET_ID=
COS_CHAT_SECRET_KEY=
COS_CHAT_BUCKET=
COS_CHAT_REGION=

SMS_PROVIDER=dev
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# 生产环境必须开启；Redis异常时仍有单实例本机限流兜底。
REDIS_ENABLED=true
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# Telegram 管理后台登录通知。每套部署必须用自己的 Bot，禁止复制其他项目的 Token/群。
TELEGRAM_ALERT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PLATFORM_NAME=
TELEGRAM_ALERT_DEDUPE_TTL=5m

# Cloudflare Turnstile - 管理后台登录
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_EXPECTED_HOSTNAME=ht.wuyoubei.com
TURNSTILE_EXPECTED_HOSTNAMES=

# Cloudflare Turnstile - Web 端登录
WEB_TURNSTILE_ENABLED=false
WEB_TURNSTILE_SECRET_KEY=
WEB_TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
WEB_TURNSTILE_EXPECTED_HOSTNAME=web.wuyoubei.com
WEB_TURNSTILE_EXPECTED_HOSTNAMES=

# 危险兼容开关：仅控制“IM 全局通用密码”。万能验证码由后台账号设置页开关控制。
DANGEROUS_AUTH_BYPASS_ENABLED=false
