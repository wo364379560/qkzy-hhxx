{
  "name": "rtcube-vite-react-ziyan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --force",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5175 && cross-env NODE_ENV=development electron .\"",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "test:interop": "node --test tests/chatInterop.test.mjs",
    "verify:domain-pool": "node --test scripts/verify-domain-pool.mjs",
    "verify:route-transport": "node --test scripts/verify-route-transport.mjs"
  },
  "dependencies": {
    "@tencentcloud/chat": "^3.6.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.28.0",
    "tim-upload-plugin": "^1.4.3",
    "trtc-sdk-v5": "^5.11.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "typescript": "~5.6.2",
    "vite": "^5.4.19",
    "wait-on": "^7.2.0"
  }
}
