<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220">

    <com.tencent.rtmp.ui.TXCloudVideoView
        android:id="@+id/remoteVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0B1220" />

    <View
        android:id="@+id/blurBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_rtc_gradient" />

    <LinearLayout
        android:id="@+id/infoPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="80dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <FrameLayout
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:background="@drawable/bg_rtc_avatar_ring">

            <TextView
                android:id="@+id/avatarLetter"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_rtc_avatar"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/nameLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#B3FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/durationLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="52dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />

    <com.tencent.rtmp.ui.TXCloudVideoView
        android:id="@+id/localVideo"
        android:layout_width="112dp"
        android:layout_height="160dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="52dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_rtc_local_video"
        android:elevation="8dp" />

    <ImageButton
        android:id="@+id/minimizeButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="14dp"
        android:layout_marginTop="44dp"
        android:background="@drawable/bg_rtc_control"
        android:contentDescription="缩小通话"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_call_minimize"
        app:tint="#FFFFFF" />

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <LinearLayout
            android:id="@+id/controlsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingBottom="20dp">

            <ImageButton
                android:id="@+id/micButton"
                style="@style/RtcRoundControl"
                android:contentDescription="麦克风"
                android:src="@android:drawable/ic_btn_speak_now" />

            <ImageButton
                android:id="@+id/speakerButton"
                style="@style/RtcRoundControl"
                android:contentDescription="扬声器"
                android:tint="@color/rtc_control_tint"
                android:src="@drawable/ic_rtc_speaker" />

            <ImageButton
                android:id="@+id/cameraFlipButton"
                style="@style/RtcRoundControl"
                android:contentDescription="翻转摄像头"
                android:src="@android:drawable/ic_menu_camera" />

            <ImageButton
                android:id="@+id/cameraOffButton"
                style="@style/RtcRoundControl"
                android:contentDescription="摄像头开关"
                android:src="@android:drawable/ic_menu_camera" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actionRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/rejectWrap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <Button
                    android:id="@+id/rejectButton"
                    style="@style/RtcActionReject"
                    android:text="拒绝" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/acceptWrap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <Button
                    android:id="@+id/acceptButton"
                    style="@style/RtcActionAccept"
                    android:text="接听" />
            </LinearLayout>

            <Button
                android:id="@+id/cancelButton"
                style="@style/RtcActionReject"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:text="取消" />

            <Button
                android:id="@+id/hangupButton"
                style="@style/RtcActionReject"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:text="挂断" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
