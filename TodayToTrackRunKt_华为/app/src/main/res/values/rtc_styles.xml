<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="RtcRoundControl" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:background">@drawable/bg_rtc_control_selector</item>
        <item name="android:padding">12dp</item>
        <item name="tint">@color/rtc_control_tint</item>
        <item name="android:scaleType">centerInside</item>
    </style>

    <style name="RtcActionReject" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">92dp</item>
        <item name="android:layout_height">92dp</item>
        <item name="android:background">@drawable/bg_rtc_reject</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="RtcActionAccept" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">92dp</item>
        <item name="android:layout_height">92dp</item>
        <item name="android:background">@drawable/bg_rtc_accept</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
